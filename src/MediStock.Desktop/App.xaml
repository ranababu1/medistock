<Application x:Class="MediStock.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediStock.Desktop.ViewModels"
             xmlns:views="clr-namespace:MediStock.Desktop.Views"
             xmlns:conv="clr-namespace:MediStock.Desktop.Converters"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:NotNullToBooleanConverter x:Key="NotNull" />
            <conv:NotNullToVisibilityConverter x:Key="NotNullVisible" />
            <conv:ActiveStatusConverter x:Key="ActiveStatus" />
            <conv:EnumTextConverter x:Key="EnumText" />
            <conv:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTime" />
            <conv:InstantTextConverter x:Key="InstantText" />

            <!-- View-model to view mapping used by the shell's content region. -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MedicinesViewModel}">
                <views:MedicinesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SuppliersViewModel}">
                <views:SuppliersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PurchasesViewModel}">
                <views:PurchasesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
                <views:InventoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NewSaleViewModel}">
                <views:NewSaleView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SalesHistoryViewModel}">
                <views:SalesHistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReturnsViewModel}">
                <views:ReturnsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <views:ReportsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UsersSettingsViewModel}">
                <views:UsersSettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
                <views:PlaceholderView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
