<UserControl x:Class="MediStock.Desktop.Views.MedicinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediStock.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MedicinesViewModel}"
             d:DesignHeight="620"
             d:DesignWidth="1040"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Medicines" Style="{StaticResource PageTitleText}" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                           Text="Catalogue records are never deleted. Deactivated medicines stay available for historical invoices and stock." />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="New medicine"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding NewMedicineCommand}"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- Search bar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{StaticResource ThemedTextBox}"
                         Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by name, brand, generic name, manufacturer, or barcode">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <CheckBox Grid.Column="1"
                          Style="{StaticResource ThemedCheckBox}"
                          Content="Include inactive"
                          Margin="14,0,0,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IncludeInactive}" />

                <Button Grid.Column="2"
                        Content="Search"
                        Style="{StaticResource SecondaryButton}"
                        Margin="14,0,0,0"
                        Command="{Binding SearchCommand}" />

                <Button Grid.Column="3"
                        Content="Clear"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        Command="{Binding ClearSearchCommand}" />

                <TextBlock Grid.Column="4"
                           Style="{StaticResource CaptionText}"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding ResultSummary}" />
            </Grid>
        </Border>

        <!-- List and editor -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Medicines}"
                              SelectedItem="{Binding SelectedMedicine, Mode=TwoWay}"
                              Style="{StaticResource ThemedDataGrid}"
                              BorderThickness="0"
                              AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="2*" />
                            <DataGridTextColumn Header="Strength" Binding="{Binding Strength}" Width="Auto" />
                            <DataGridTextColumn Header="Form" Binding="{Binding DosageForm}" Width="Auto" />
                            <DataGridTextColumn Header="Generic name" Binding="{Binding GenericName}" Width="*" />
                            <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="Auto" />
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding IsActive, Converter={StaticResource ActiveStatus}}"
                                                Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="320"
                               TextAlignment="Center"
                               Text="No catalogue records yet, or nothing matches the current search. Use New medicine to add the first record."
                               Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Width="8" Background="Transparent" />

            <!-- Editor -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Width="420">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Editor.Heading}" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />

                        <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />

                        <Border Visibility="{Binding Editor.HasValidationMessage, Converter={StaticResource BoolToVisibility}}"
                                Background="{StaticResource DangerSoftBrush}"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,12">
                            <TextBlock Text="{Binding Editor.ValidationMessage}"
                                       Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="12" />
                        </Border>

                        <TextBlock Text="Display name" Style="{StaticResource FieldLabelText}" />
                        <TextBox Style="{StaticResource ThemedTextBox}"
                                 Text="{Binding Editor.DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Brand name" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding Editor.BrandName}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Generic name" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding Editor.GenericName}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Strength" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding Editor.Strength}"
                                         ToolTip="For example 500 mg" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Dosage form" Style="{StaticResource FieldLabelText}" />
                                <ComboBox Style="{StaticResource ThemedComboBox}"
                                          ItemsSource="{Binding Editor.DosageForms}"
                                          SelectedItem="{Binding Editor.DosageForm}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Manufacturer" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding Editor.Manufacturer}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Barcode" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding Editor.Barcode}"
                                         ToolTip="Must be unique across the catalogue when supplied" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Pack / unit" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding Editor.PackDescription}"
                                         ToolTip="For example 10 tablets per strip" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Reorder threshold" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource ThemedTextBox}"
                                 Text="{Binding Editor.ReorderThreshold, TargetNullValue=''}"
                                 ToolTip="Leave empty to exclude this medicine from the low-stock list" />

                        <CheckBox Style="{StaticResource ThemedCheckBox}"
                                  Content="Active and available for new sales"
                                  Margin="0,14,0,0"
                                  IsChecked="{Binding Editor.IsActive}" />

                        <Border Style="{StaticResource Divider}" Margin="0,16,0,14" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding Editor.SaveButtonText}"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveCommand}" />
                            <Button Content="Reset"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding ResetEditorCommand}" />
                            <Button Content="Deactivate"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding ToggleActiveCommand}"
                                    IsEnabled="{Binding SelectedMedicine, Converter={StaticResource NotNull}}" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
