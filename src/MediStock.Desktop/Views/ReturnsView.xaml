<UserControl x:Class="MediStock.Desktop.Views.ReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediStock.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReturnsViewModel}"
             d:DesignHeight="900"
             d:DesignWidth="1140"
             Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,20">
        <StackPanel>

            <!-- Header -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Returns &amp; Adjustments" Style="{StaticResource PageTitleText}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                               Text="Taking medicine back is recorded, never erased. A return names the invoice it came from, refunds it, and decides on the record what happens to the goods." />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center">
                        <Run Text="Next return number:" />
                        <Run Text="{Binding NextReturnNumber, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <Button Content="Clear the form"
                            Style="{StaticResource SecondaryButton}"
                            Margin="16,0,0,0"
                            Command="{Binding ClearFormCommand}" />
                </StackPanel>
            </Grid>

            <!-- Banners -->
            <StackPanel>
                <Border Style="{StaticResource Card}"
                        Margin="0,0,0,10"
                        Padding="14,10"
                        Background="{StaticResource DangerSoftBrush}"
                        BorderBrush="#F2C9C9"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                </Border>

                <Border Style="{StaticResource Card}"
                        Margin="0,0,0,10"
                        Padding="14,10"
                        Background="{StaticResource SuccessSoftBrush}"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NotNullVisible}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <!-- Take a return -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,4,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Find the invoice -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Invoice number" Style="{StaticResource FieldLabelText}" />
                            <TextBox Style="{StaticResource ThemedTextBox}"
                                     Margin="0,4,0,0"
                                     Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding FindInvoiceCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Find invoice"
                                Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,1"
                                Command="{Binding FindInvoiceCommand}"
                                IsEnabled="{Binding IsNotBusy}" />

                        <TextBlock Grid.Column="3"
                                   Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Bottom"
                                   Margin="16,0,0,6"
                                   TextWrapping="Wrap"
                                   Text="Everything on the invoice that has not already come back is listed below, batch by batch." />
                    </Grid>

                    <!-- What is on the invoice -->
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding InvoiceHeading}" Style="{StaticResource SectionHeaderText}" />
                            <TextBlock Text="{Binding InvoiceSummary}"
                                       Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Cancel the invoice"
                                Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Top"
                                Command="{Binding CancelInvoiceCommand}"
                                IsEnabled="{Binding CanCancelInvoice}"
                                ToolTip="Offered once every unit on the invoice has been returned. Cancelling keeps the invoice number and its lines; it records who decided and why." />
                    </Grid>

                    <!-- Returnable lines, one row per batch -->
                    <Grid Grid.Row="2" Margin="0,12,0,0"
                          Visibility="{Binding HasInvoice, Converter={StaticResource BoolToVisibility}}">
                        <DataGrid ItemsSource="{Binding ReturnLines}"
                                  Style="{StaticResource ThemedDataGrid}"
                                  Height="230"
                                  RowHeight="40"
                                  IsReadOnly="False"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="40" IsReadOnly="True" />
                                <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineName}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="Auto" IsReadOnly="True" />
                                <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryText}" Width="Auto" IsReadOnly="True" />
                                <DataGridTextColumn Header="Sold" Binding="{Binding SoldQuantity, StringFormat={}{0:0.###}}" Width="70" IsReadOnly="True" />
                                <DataGridTextColumn Header="Returnable" Binding="{Binding ReturnableText}" Width="90" IsReadOnly="True" />
                                <DataGridTextColumn Header="Coming back"
                                                    Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.###}}"
                                                    Width="95" />
                                <DataGridTemplateColumn Header="Disposition" Width="210">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource ThemedComboBox}"
                                                      ItemsSource="{Binding Dispositions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedItem="{Binding SelectedDisposition, Mode=TwoWay}"
                                                      Margin="0,2" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Refund"
                                                    Binding="{Binding RefundPreviewText}"
                                                    Width="90" IsReadOnly="True" />
                                <DataGridTextColumn Header="Note"
                                                    Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="180" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Style="{StaticResource CaptionText}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasNoReturnableLines, Converter={StaticResource BoolToVisibility}}"
                                   Text="Nothing on this invoice can still be returned." />
                    </Grid>

                    <!-- Who, why, how the money goes back -->
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Reason (required, recorded on the return)" Style="{StaticResource FieldLabelText}" />
                            <TextBox Style="{StaticResource ThemedTextBox}"
                                     Margin="0,4,0,0"
                                     Text="{Binding ReturnReason, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Business date" Style="{StaticResource FieldLabelText}" />
                            <DatePicker Margin="0,4,0,0"
                                        SelectedDate="{Binding BusinessDate, Converter={StaticResource DateOnlyToDateTime}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Refunded by" Style="{StaticResource FieldLabelText}" />
                            <ComboBox Style="{StaticResource ThemedComboBox}"
                                      Margin="0,4,0,0"
                                      ItemsSource="{Binding RefundMethods}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedRefundMethod}" />
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Taken back by" Style="{StaticResource FieldLabelText}" />
                            <TextBlock Text="{Binding ReturnedBy}"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- What it comes to -->
                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionHeaderText}">
                                <Run Text="Refund " />
                                <Run Text="{Binding RefundPreviewText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding RefundPreviewSummary}"
                                       Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Record the return"
                                Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Center"
                                Command="{Binding RecordReturnCommand}"
                                IsEnabled="{Binding CanTakeReturn}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Recent returns -->
            <Border Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Recent returns" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap"
                                   Text="Customer returns and what happened to the goods. A restocked row went back on a shelf; everything else stayed out of sellable stock." />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Return number, invoice or medicine" Style="{StaticResource FieldLabelText}" />
                            <TextBox Style="{StaticResource ThemedTextBox}"
                                     Margin="0,4,0,0"
                                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="From business date" Style="{StaticResource FieldLabelText}" />
                            <DatePicker Margin="0,4,0,0"
                                        SelectedDate="{Binding From, Converter={StaticResource DateOnlyToDateTime}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="To business date" Style="{StaticResource FieldLabelText}" />
                            <DatePicker Margin="0,4,0,0"
                                        SelectedDate="{Binding To, Converter={StaticResource DateOnlyToDateTime}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Disposition" Style="{StaticResource FieldLabelText}" />
                            <ComboBox Style="{StaticResource ThemedComboBox}"
                                      Margin="0,4,0,0"
                                      ItemsSource="{Binding DispositionFilters}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedDispositionFilter}" />
                        </StackPanel>

                        <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Search"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding SearchCommand}"
                                    IsEnabled="{Binding IsNotBusy}" />
                            <Button Content="All dates"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding ClearFiltersCommand}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding ResultSummary}" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="16,0,0,0">
                            <Run Text="Listed refunds: " />
                            <Run Text="{Binding ListedRefundText, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <DataGrid ItemsSource="{Binding Returns}"
                                          SelectedItem="{Binding SelectedReturn, Mode=TwoWay}"
                                          Style="{StaticResource ThemedDataGrid}"
                                          BorderThickness="0"
                                          Height="200"
                                          AlternationCount="2">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Return" Binding="{Binding ReturnNumber}" Width="Auto" />
                                        <DataGridTextColumn Header="Business date" Binding="{Binding BusinessDate, StringFormat=yyyy-MM-dd}" Width="Auto" />
                                        <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="Auto" />
                                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />
                                        <DataGridTextColumn Header="Taken back by" Binding="{Binding ReturnedBy}" Width="Auto" />
                                        <DataGridTextColumn Header="Units" Binding="{Binding ReturnedQuantity, StringFormat={}{0:0.###}}" Width="Auto" />
                                        <DataGridTextColumn Header="Restocked" Binding="{Binding RestockedQuantity, StringFormat={}{0:0.###}}" Width="Auto" />
                                        <DataGridTextColumn Header="Refund" Binding="{Binding RefundTotal, StringFormat=N2}" Width="Auto" />
                                        <DataGridTextColumn Header="Refunded by" Binding="{Binding RefundMethod, Converter={StaticResource EnumText}}" Width="Auto" />
                                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           MaxWidth="380"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Text="No returns match these filters. Widen the date range, or clear the filters."
                                           Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding DetailHeading}" Style="{StaticResource SectionHeaderText}" />
                                    <TextBlock Text="{Binding DetailSummary}"
                                               Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding SelectedReturn.Lines}"
                                          Style="{StaticResource ThemedDataGrid}"
                                          BorderThickness="0"
                                          Height="160">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="40" />
                                        <DataGridTextColumn Header="Invoice line" Binding="{Binding InvoiceLineNumber}" Width="Auto" />
                                        <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineName}" Width="*" />
                                        <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="Auto" />
                                        <DataGridTextColumn Header="Units" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="Auto" />
                                        <DataGridTextColumn Header="Refund" Binding="{Binding RefundAmount, StringFormat=N2}" Width="Auto" />
                                        <DataGridTextColumn Header="Disposition" Binding="{Binding Disposition, Converter={StaticResource EnumText}}" Width="Auto" />
                                        <DataGridTextColumn Header="Note" Binding="{Binding Notes}" Width="200" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Send stock back to a supplier -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Send stock back to a supplier" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap"
                                   Text="Credit stock out to the supplier it was bought from. The credit is expected at the cost frozen on each batch, and each line is checked against the ledger again before the return is booked." />
                    </StackPanel>

                    <TextBlock Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"
                               Visibility="{Binding CannotReturnToSupplier, Converter={StaticResource BoolToVisibility}}"
                               Text="{Binding SupplierReturnRefusalNote}" />

                    <StackPanel Visibility="{Binding CanReturnToSupplier, Converter={StaticResource BoolToVisibility}}">
                        <!-- The draft's heading: who is credited, why, and by whom -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Supplier" Style="{StaticResource FieldLabelText}" />
                                <ComboBox Style="{StaticResource ThemedComboBox}"
                                          Margin="0,4,0,0"
                                          ItemsSource="{Binding SupplierOptions}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Reason (required)" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource ThemedTextBox}"
                                         Margin="0,4,0,0"
                                         Text="{Binding SupplierReturnReason, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Supplier credit note (optional)" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource ThemedTextBox}"
                                         Margin="0,4,0,0"
                                         Text="{Binding SupplierCreditNote, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Returned by" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource ThemedTextBox}"
                                         Margin="0,4,0,0"
                                         Text="{Binding SupplierReturnedBy, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="8">
                                <TextBlock Text="Next return number" Style="{StaticResource FieldLabelText}" />
                                <TextBlock Text="{Binding NextSupplierReturnNumber}"
                                           Style="{StaticResource MetricValueText}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Batches this supplier was paid for, still with stock on hand -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Batch search (medicine or batch number)" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource ThemedTextBox}"
                                         Margin="0,4,0,0"
                                         Text="{Binding BatchSearchTerm, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SearchBatchChoicesCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="Search batches"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,24,0,0"
                                    VerticalAlignment="Top"
                                    Command="{Binding SearchBatchChoicesCommand}" />
                        </Grid>

                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,8" Text="{Binding BatchChoicesSummary}" />

                        <Grid>
                            <DataGrid ItemsSource="{Binding BatchChoices}"
                                      SelectedItem="{Binding SelectedBatchChoice, Mode=TwoWay}"
                                      Style="{StaticResource ThemedDataGrid}"
                                      BorderThickness="0"
                                      Height="150"
                                      IsReadOnly="True"
                                      AlternationCount="2"
                                      Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineName}" Width="*" />
                                    <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="Auto" />
                                    <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, StringFormat=yyyy-MM-dd}" Width="Auto" />
                                    <DataGridTextColumn Header="On hand" Binding="{Binding QuantityOnHand, StringFormat={}{0:0.###}}" Width="Auto" />
                                    <DataGridTextColumn Header="Unit cost" Binding="{Binding PurchaseCost, StringFormat=N2}" Width="Auto" />
                                    <DataGridTextColumn Header="Supplier invoice" Binding="{Binding SupplierInvoiceNumber}" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       MaxWidth="420"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Text="No batches match. Search by medicine or batch number; only batches bought from this supplier can go back to them."
                                       Visibility="{Binding HasNoBatchChoices, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Add to return"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding AddSupplierReturnLineCommand}"
                                    IsEnabled="{Binding CanAddSupplierReturnLine}"
                                    ToolTip="Adds the picked batch to the return, asking how many units are going back." />
                        </StackPanel>

                        <!-- The lines on the draft -->
                        <TextBlock Style="{StaticResource SectionHeaderText}" Text="Lines on this return" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasSupplierReturnLines, Converter={StaticResource BoolToVisibility}}"
                                   Text="{Binding SupplierReturnDraftSummary}" />

                        <Grid Visibility="{Binding HasSupplierReturnLines, Converter={StaticResource BoolToVisibility}}"
                              Margin="0,0,0,12">
                            <DataGrid ItemsSource="{Binding SupplierReturnLines}"
                                      Style="{StaticResource ThemedDataGrid}"
                                      BorderThickness="0"
                                      Height="180"
                                      IsReadOnly="True"
                                      AlternationCount="2"
                                      Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineName}" Width="*" />
                                    <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="Auto" />
                                    <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, StringFormat=yyyy-MM-dd}" Width="Auto" />
                                    <DataGridTextColumn Header="On hand" Binding="{Binding QuantityOnHand, StringFormat={}{0:0.###}}" Width="Auto" />
                                    <DataGridTextColumn Header="Going back"
                                                        Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.###}}"
                                                        IsReadOnly="False"
                                                        Width="Auto" />
                                    <DataGridTextColumn Header="Unit cost" Binding="{Binding UnitCost, StringFormat=N2}" Width="Auto" />
                                    <DataGridTextColumn Header="Credit expected" Binding="{Binding CreditValueText}" Width="Auto" />
                                    <DataGridTemplateColumn Header="" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Remove"
                                                        Style="{StaticResource LinkButton}"
                                                        Command="{Binding DataContext.RemoveSupplierReturnLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                        Visibility="{Binding HasSupplierReturnLines, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource SectionHeaderText}">
                                    <Run Text="Credit expected: " />
                                    <Run Text="{Binding ExpectedSupplierCreditText, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           Text="At each batch's frozen purchase cost, the figure the recorded return credits." />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Clear the draft"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0"
                                        Command="{Binding ClearSupplierReturnDraftCommand}"
                                        IsEnabled="{Binding CanClearSupplierReturnDraft}" />
                                <Button Content="Record supplier return"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding RecordSupplierReturnCommand}"
                                        IsEnabled="{Binding CanRecordSupplierReturn}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Supplier return history -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Supplier return history" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap"
                                   Text="Returns already credited out to suppliers. Each one is history: it is corrected by a further return or a write-off, never by editing it." />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Return number, supplier or reason" Style="{StaticResource FieldLabelText}" />
                            <TextBox Style="{StaticResource ThemedTextBox}"
                                     Margin="0,4,0,0"
                                     Text="{Binding SupplierReturnSearchTerm, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SearchSupplierReturnsCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="From business date" Style="{StaticResource FieldLabelText}" />
                            <DatePicker Margin="0,4,0,0"
                                        SelectedDate="{Binding SupplierReturnFrom, Converter={StaticResource DateOnlyToDateTime}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="To business date" Style="{StaticResource FieldLabelText}" />
                            <DatePicker Margin="0,4,0,0"
                                        SelectedDate="{Binding SupplierReturnTo, Converter={StaticResource DateOnlyToDateTime}}" />
                        </StackPanel>

                        <Button Grid.Column="6"
                                Content="Search"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,22,0,0"
                                VerticalAlignment="Top"
                                Command="{Binding SearchSupplierReturnsCommand}" />

                        <Button Grid.Column="8"
                                Content="Clear filters"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,22,0,0"
                                VerticalAlignment="Top"
                                Command="{Binding ClearSupplierReturnFiltersCommand}" />
                    </Grid>

                    <TextBlock Grid.Row="2" Style="{StaticResource CaptionText}" Margin="0,0,0,8" Text="{Binding SupplierReturnsResultSummary}" />

                    <Grid Grid.Row="3">
                        <DataGrid ItemsSource="{Binding SupplierReturns}"
                                  SelectedItem="{Binding SelectedSupplierReturn, Mode=TwoWay}"
                                  Style="{StaticResource ThemedDataGrid}"
                                  BorderThickness="0"
                                  Height="170"
                                  IsReadOnly="True"
                                  AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Return" Binding="{Binding ReturnNumber}" Width="Auto" />
                                <DataGridTextColumn Header="Business date" Binding="{Binding BusinessDate, StringFormat=yyyy-MM-dd}" Width="Auto" />
                                <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*" />
                                <DataGridTextColumn Header="Units" Binding="{Binding ReturnedQuantity, StringFormat={}{0:0.###}}" Width="Auto" />
                                <DataGridTextColumn Header="Credit expected" Binding="{Binding TotalCostValue, StringFormat=N2}" Width="Auto" />
                                <DataGridTextColumn Header="Returned by" Binding="{Binding ReturnedBy}" Width="Auto" />
                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   MaxWidth="420"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Text="No supplier returns match these filters. Widen the date range, or clear the filters."
                                   Visibility="{Binding HasNoSupplierReturns, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Selected supplier return, opened in full -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SupplierReturnDetailHeading}" Style="{StaticResource SectionHeaderText}" />
                            <TextBlock Text="{Binding SupplierReturnDetailSummary}"
                                       Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Show lines"
                                Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Center"
                                Command="{Binding ViewSupplierReturnDetailCommand}"
                                IsEnabled="{Binding CanViewSupplierReturnDetail}" />
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding SupplierReturnDetail.Lines}"
                              Style="{StaticResource ThemedDataGrid}"
                              BorderThickness="0"
                              Height="160"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="40" />
                            <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineName}" Width="*" />
                            <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="Auto" />
                            <DataGridTextColumn Header="Units" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="Auto" />
                            <DataGridTextColumn Header="Unit cost" Binding="{Binding UnitCost, StringFormat=N2}" Width="Auto" />
                            <DataGridTextColumn Header="Credit expected" Binding="{Binding CostValue, StringFormat=N2}" Width="Auto" />
                            <DataGridTextColumn Header="Note" Binding="{Binding Notes}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Stock held in quarantine -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Stock held in quarantine" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap"
                                   Text="Everything that must not leave the shelf: kept-back customer returns, batches under a recall notice, and batches written off. Stock leaves this list when its batch is dealt with — write-offs and further corrections are made from the Inventory screen." />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Medicine, batch or reason" Style="{StaticResource FieldLabelText}" />
                            <TextBox Style="{StaticResource ThemedTextBox}"
                                     Margin="0,4,0,0"
                                     Text="{Binding QuarantineSearchTerm, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding LoadQuarantinedCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Search"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,22,0,0"
                                VerticalAlignment="Top"
                                Command="{Binding LoadQuarantinedCommand}" />

                        <Button Grid.Column="4"
                                Content="Clear"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,22,0,0"
                                VerticalAlignment="Top"
                                Command="{Binding ClearQuarantineSearchCommand}" />
                    </Grid>

                    <TextBlock Grid.Row="2" Style="{StaticResource CaptionText}" Margin="0,0,0,8" Text="{Binding QuarantinedResultSummary}" />

                    <Grid Grid.Row="3">
                        <DataGrid ItemsSource="{Binding Quarantined}"
                                  Style="{StaticResource ThemedDataGrid}"
                                  BorderThickness="0"
                                  Height="200"
                                  IsReadOnly="True"
                                  AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Held because" Binding="{Binding Source, Converter={StaticResource EnumText}}" Width="Auto" />
                                <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineName}" Width="*" />
                                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="Auto" />
                                <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, StringFormat=yyyy-MM-dd}" Width="Auto" />
                                <DataGridTextColumn Header="Units" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="Auto" />
                                <DataGridTextColumn Header="Held since" Binding="{Binding QuarantinedOn, StringFormat=yyyy-MM-dd}" Width="Auto" />
                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="1.5*" />
                                <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   MaxWidth="420"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Text="Nothing is held in quarantine. Stock lands here when a customer return is kept back, or when a batch is quarantined from the Inventory screen."
                                   Visibility="{Binding HasNoQuarantined, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
