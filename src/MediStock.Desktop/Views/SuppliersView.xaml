<UserControl x:Class="MediStock.Desktop.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediStock.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SuppliersViewModel}"
             d:DesignHeight="620"
             d:DesignWidth="1040"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Suppliers" Style="{StaticResource PageTitleText}" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                           Text="Supplier records are never deleted. Deactivated suppliers stay available for historical purchases." />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="New supplier"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding NewSupplierCommand}"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- Search bar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{StaticResource ThemedTextBox}"
                         Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by name, contact person, phone, GSTIN, or drug licence number">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <CheckBox Grid.Column="1"
                          Style="{StaticResource ThemedCheckBox}"
                          Content="Include inactive"
                          Margin="14,0,0,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IncludeInactive}" />

                <Button Grid.Column="2"
                        Content="Search"
                        Style="{StaticResource SecondaryButton}"
                        Margin="14,0,0,0"
                        Command="{Binding SearchCommand}" />

                <Button Grid.Column="3"
                        Content="Clear"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        Command="{Binding ClearSearchCommand}" />

                <TextBlock Grid.Column="4"
                           Style="{StaticResource CaptionText}"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding ResultSummary}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- List and purchase history -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.4*" MinHeight="180" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" MinHeight="140" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <DataGrid ItemsSource="{Binding Suppliers}"
                                  SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                                  Style="{StaticResource ThemedDataGrid}"
                                  BorderThickness="0"
                                  AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Supplier" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Contact" Binding="{Binding ContactPerson}" Width="*" />
                                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="Auto" />
                                <DataGridTextColumn Header="City" Binding="{Binding City}" Width="Auto" />
                                <DataGridTextColumn Header="Status"
                                                    Binding="{Binding IsActive, Converter={StaticResource ActiveStatus}}"
                                                    Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="320"
                                   TextAlignment="Center"
                                   Text="No supplier records yet, or nothing matches the current search. Use New supplier to add the first record."
                                   Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="Purchase history" Style="{StaticResource SectionHeaderText}" />
                            <TextBlock Text="{Binding HistorySummary}"
                                       Style="{StaticResource CaptionText}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding PurchaseHistory}"
                                  Style="{StaticResource ThemedDataGrid}"
                                  BorderThickness="0"
                                  IsReadOnly="True"
                                  Margin="0,10,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="*" />
                                <DataGridTextColumn Header="Date"
                                                    Binding="{Binding InvoiceDate, StringFormat=yyyy-MM-dd}"
                                                    Width="Auto" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                                <DataGridTextColumn Header="Value"
                                                    Binding="{Binding TotalValue, StringFormat=N2}"
                                                    Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button Grid.Row="2"
                                Content="Open purchases"
                                Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                Command="{Binding OpenPurchasesCommand}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Editor -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Editor.Heading}" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />

                        <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />

                        <Border Visibility="{Binding Editor.HasValidationMessage, Converter={StaticResource BoolToVisibility}}"
                                Background="{StaticResource DangerSoftBrush}"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,12">
                            <TextBlock Text="{Binding Editor.ValidationMessage}"
                                       Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="12" />
                        </Border>

                        <TextBlock Text="Supplier name" Style="{StaticResource FieldLabelText}" />
                        <TextBox Style="{StaticResource ThemedTextBox}"
                                 Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Contact person" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding Editor.ContactPerson}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Phone" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding Editor.Phone}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Email" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding Editor.Email}" />

                        <TextBlock Text="Address" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding Editor.AddressLine}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" MinWidth="96" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="City" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding Editor.City}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="State" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding Editor.State}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="PIN code" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding Editor.PostalCode}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="GSTIN" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding Editor.Gstin}"
                                         ToolTip="Must be unique across suppliers when supplied" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Drug licence number" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding Editor.DrugLicenseNumber}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Notes" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource ThemedTextBox}"
                                 Text="{Binding Editor.Notes}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="56"
                                 VerticalScrollBarVisibility="Auto" />

                        <CheckBox Style="{StaticResource ThemedCheckBox}"
                                  Content="Active and available for new purchases"
                                  Margin="0,14,0,0"
                                  IsChecked="{Binding Editor.IsActive}" />

                        <Border Style="{StaticResource Divider}" Margin="0,16,0,14" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding Editor.SaveButtonText}"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveCommand}" />
                            <Button Content="Reset"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding ResetEditorCommand}" />
                            <Button Content="Deactivate"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding ToggleActiveCommand}"
                                    IsEnabled="{Binding SelectedSupplier, Converter={StaticResource NotNull}}" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
