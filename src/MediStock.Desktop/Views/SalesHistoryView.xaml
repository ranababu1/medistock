<UserControl x:Class="MediStock.Desktop.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediStock.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SalesHistoryViewModel}"
             d:DesignHeight="720"
             d:DesignWidth="1140"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Sales History" Style="{StaticResource PageTitleText}" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                           Text="Completed invoices are kept as historical records. They are read and reprinted here, never edited." />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Reprint invoice"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding ReprintCommand}"
                    IsEnabled="{Binding HasSelection}"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- Banners -->
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,10"
                    Padding="14,10"
                    Background="{StaticResource DangerSoftBrush}"
                    BorderBrush="#F2C9C9"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,10"
                    Padding="14,10"
                    Background="{StaticResource SuccessSoftBrush}"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NotNull}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Filters -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" MinWidth="140" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" MinWidth="140" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" MinWidth="140" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Invoice number, customer or medicine" Style="{StaticResource FieldLabelText}" />
                    <TextBox Style="{StaticResource ThemedTextBox}"
                             Margin="0,4,0,0"
                             Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="From business date" Style="{StaticResource FieldLabelText}" />
                    <DatePicker Margin="0,4,0,0"
                                SelectedDate="{Binding From, Converter={StaticResource DateOnlyToDateTime}}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4">
                    <TextBlock Text="To business date" Style="{StaticResource FieldLabelText}" />
                    <DatePicker Margin="0,4,0,0"
                                SelectedDate="{Binding To, Converter={StaticResource DateOnlyToDateTime}}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="6">
                    <TextBlock Text="Status" Style="{StaticResource FieldLabelText}" />
                    <ComboBox Style="{StaticResource ThemedComboBox}"
                              Margin="0,4,0,0"
                              ItemsSource="{Binding StatusFilters}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedStatusFilter}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7"
                            Orientation="Horizontal" Margin="0,10,0,0">
                    <ComboBox Style="{StaticResource ThemedComboBox}"
                              MinWidth="190"
                              ItemsSource="{Binding PaymentFilters}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedPaymentFilter}" />

                    <Button Content="Search"
                            Style="{StaticResource SecondaryButton}"
                            Margin="10,0,0,0"
                            Command="{Binding SearchCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                    <Button Content="Today only"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0"
                            Command="{Binding ClearFiltersCommand}" />

                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding ResultSummary}" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center">
                        <Run Text="Listed takings: " />
                        <Run Text="{Binding ListedTotalText, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" (cancelled invoices excluded)" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Invoices and invoice detail -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.2*" MinHeight="170" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" MinHeight="200" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Sales}"
                              SelectedItem="{Binding SelectedSale, Mode=TwoWay}"
                              Style="{StaticResource ThemedDataGrid}"
                              BorderThickness="0"
                              IsReadOnly="True"
                              AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="Auto" />
                            <DataGridTextColumn Header="Business date" Binding="{Binding BusinessDate, StringFormat=yyyy-MM-dd}" Width="Auto" />
                            <DataGridTextColumn Header="Sold at" Binding="{Binding SoldAtUtc, StringFormat='{}{0:dd/MM/yyyy HH:mm}', ConverterCulture=en-GB}" Width="Auto" />
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />
                            <DataGridTextColumn Header="Served by" Binding="{Binding SoldBy}" Width="Auto" />
                            <DataGridTextColumn Header="Lines" Binding="{Binding Lines.Count}" Width="Auto" />
                            <DataGridTextColumn Header="Tax" Binding="{Binding TaxTotal, StringFormat=N2}" Width="Auto" />
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="Auto" />
                            <DataGridTextColumn Header="Payment" Binding="{Binding Payments.Count}" Width="Auto" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               MaxWidth="360"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Text="No invoices match these filters. Widen the date range, or clear the filters."
                               Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding DetailHeading}" Style="{StaticResource SectionHeaderText}" />
                            <TextBlock Style="{StaticResource CaptionText}">
                                <Run Text="{Binding SelectedSale.Total, Mode=OneWay, StringFormat=N2, FallbackValue=0.00}" />
                                <Run Text=" total, " />
                                <Run Text="{Binding SelectedSale.TaxTotal, Mode=OneWay, StringFormat=N2, FallbackValue=0.00}" />
                                <Run Text=" of it tax. Batch allocation is the stock that left the shelf." />
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding SelectedSale.Lines}"
                              Style="{StaticResource ThemedDataGrid}"
                              BorderThickness="0"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="Auto" />
                            <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineName}" Width="*" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat=N3}" Width="Auto" />
                            <DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="Auto" />
                            <DataGridTextColumn Header="Gross" Binding="{Binding GrossAmount, StringFormat=N2}" Width="Auto" />
                            <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, StringFormat=N2}" Width="Auto" />
                            <DataGridTextColumn Header="Taxable" Binding="{Binding TaxableAmount, StringFormat=N2}" Width="Auto" />
                            <DataGridTextColumn Header="Tax %" Binding="{Binding TaxRatePercent, StringFormat=0.##}" Width="Auto" />
                            <DataGridTextColumn Header="Tax" Binding="{Binding TaxAmount, StringFormat=N2}" Width="Auto" />
                            <DataGridTextColumn Header="Line total" Binding="{Binding LineTotal, StringFormat=N2}" Width="Auto" />
                            <DataGridTextColumn Header="Batches" Binding="{Binding Allocations.Count}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
