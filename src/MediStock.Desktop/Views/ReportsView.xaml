<UserControl x:Class="MediStock.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediStock.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReportsViewModel}"
             d:DesignHeight="900"
             d:DesignWidth="1140"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Reports" Style="{StaticResource PageTitleText}" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                           Text="Every figure is read from the same transactions the rest of the application writes, so a report can always be traced back to an invoice, a return or a stock movement." />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Export to CSV"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ExportCommand}"
                        IsEnabled="{Binding HasRows}"
                        ToolTip="Writes the table exactly as shown, to the reports folder." />
                <Button Content="Clear"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        Command="{Binding ClearSelectionCommand}" />
            </StackPanel>
        </Grid>

        <!-- Banners -->
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,10"
                    Padding="14,10"
                    Background="{StaticResource DangerSoftBrush}"
                    BorderBrush="#F2C9C9"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,10"
                    Padding="14,10"
                    Background="{StaticResource SuccessSoftBrush}"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NotNullVisible}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Choose a report and the parameters it needs -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,4,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox Grid.RowSpan="3"
                         Grid.Column="0"
                         ItemsSource="{Binding Definitions}"
                         SelectedItem="{Binding SelectedDefinition}"
                         DisplayMemberPath="Title"
                         BorderBrush="{StaticResource DividerBrush}"
                         Background="{StaticResource SurfaceBrush}" />

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="{Binding SelectedDefinition.Title}"
                               Style="{StaticResource SectionHeaderText}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DefinitionDescription}"
                               Style="{StaticResource CaptionText}"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Only the controls this report actually uses are offered. -->
                <Grid Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,12,0"
                                Visibility="{Binding UsesDateRange, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="From business date" Style="{StaticResource FieldLabelText}" />
                        <DatePicker Margin="0,4,0,0"
                                    Width="140"
                                    SelectedDate="{Binding From, Converter={StaticResource DateOnlyToDateTime}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="0,0,12,0"
                                Visibility="{Binding UsesDateRange, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="To business date" Style="{StaticResource FieldLabelText}" />
                        <DatePicker Margin="0,4,0,0"
                                    Width="140"
                                    SelectedDate="{Binding To, Converter={StaticResource DateOnlyToDateTime}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Margin="0,0,12,0"
                                Visibility="{Binding UsesHorizon, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Days ahead" Style="{StaticResource FieldLabelText}" />
                        <TextBox Style="{StaticResource ThemedTextBox}"
                                 Margin="0,4,0,0"
                                 Width="80"
                                 Text="{Binding HorizonDays, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Margin="0,0,12,0"
                                Visibility="{Binding UsesTake, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Most rows" Style="{StaticResource FieldLabelText}" />
                        <TextBox Style="{StaticResource ThemedTextBox}"
                                 Margin="0,4,0,0"
                                 Width="90"
                                 Text="{Binding Take, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Margin="0,0,12,0"
                                Visibility="{Binding UsesDateRange, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="Today" Style="{StaticResource LinkButton}" Command="{Binding ShowTodayCommand}" />
                        <Button Content="Last 30 days"
                                Style="{StaticResource LinkButton}"
                                Margin="8,0,0,0"
                                Command="{Binding ShowLastMonthCommand}" />
                    </StackPanel>

                    <Button Grid.Column="6"
                            Content="Run the report"
                            Style="{StaticResource PrimaryButton}"
                            VerticalAlignment="Bottom"
                            Command="{Binding RunCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                </Grid>

                <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,12,0,0" Style="{StaticResource CaptionText}">
                    <Run Text="Rows: " />
                    <Run Text="{Binding RowSummary, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="  ·  CSV exports go to: " />
                    <Run Text="{Binding ExportFolder, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Border>

        <!-- The report itself -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{Binding ReportTitle}" Style="{StaticResource SectionHeaderText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ReportSubtitle}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <!-- Columns come from the report itself, so the viewer can show any of them; the
                         handler in the code-behind only decides which figures are lined up on the right. -->
                    <DataGrid x:Name="ReportGrid"
                              ItemsSource="{Binding Table}"
                              Style="{StaticResource ThemedDataGrid}"
                              AutoGenerateColumns="True"
                              AutoGeneratingColumn="OnAutoGeneratingColumn"
                              Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Style="{StaticResource CaptionText}"
                               MaxWidth="420"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="This report found nothing for the range it was given. An empty report is an answer: nothing was sold, nothing moved, nothing is due to expire."
                               Visibility="{Binding IsEmptyReport, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Style="{StaticResource CaptionText}"
                               MaxWidth="420"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="Choose a report on the left and run it. The figures appear here and can be exported to CSV."
                               Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
