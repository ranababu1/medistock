<UserControl x:Class="MediStock.Desktop.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediStock.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PurchasesViewModel}"
             d:DesignHeight="700"
             d:DesignWidth="1100"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Purchases" Style="{StaticResource PageTitleText}" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                           Text="A supplier invoice is recorded as a draft. Confirming it is the only way stock is taken into the pharmacy." />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="New purchase"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding NewPurchaseCommand}"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" MinWidth="150" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" MinWidth="130" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Row="0" Grid.Column="0"
                         Style="{StaticResource ThemedTextBox}"
                         Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by invoice number or supplier name">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <ComboBox Grid.Row="0" Grid.Column="2"
                          Style="{StaticResource ThemedComboBox}"
                          ItemsSource="{Binding SupplierFilters}"
                          SelectedItem="{Binding SelectedSupplierFilter}"
                          ToolTip="Filter by supplier" />

                <ComboBox Grid.Row="0" Grid.Column="4"
                          Style="{StaticResource ThemedComboBox}"
                          ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          ToolTip="Filter by purchase status" />

                <StackPanel Grid.Row="1" Grid.Column="0"
                            Grid.ColumnSpan="5"
                            Orientation="Horizontal"
                            Margin="0,10,0,0">
                    <TextBlock Text="Invoice date from" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center" />
                    <DatePicker Width="130"
                                Margin="8,0,0,0"
                                SelectedDate="{Binding InvoiceDateFrom, Converter={StaticResource DateOnlyToDateTime}}" />

                    <TextBlock Text="to" Style="{StaticResource FieldLabelText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <DatePicker Width="130"
                                Margin="8,0,0,0"
                                SelectedDate="{Binding InvoiceDateTo, Converter={StaticResource DateOnlyToDateTime}}" />

                    <Button Content="Search"
                            Style="{StaticResource SecondaryButton}"
                            Margin="12,0,0,0"
                            Command="{Binding SearchCommand}" />
                    <Button Content="Clear filters"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0"
                            Command="{Binding ClearFiltersCommand}" />

                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding ResultSummary}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="460" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="470" />
            </Grid.ColumnDefinitions>

            <!-- List and detail -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.2*" MinHeight="170" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" MinHeight="190" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <DataGrid ItemsSource="{Binding Purchases}"
                                  SelectedItem="{Binding SelectedPurchase, Mode=TwoWay}"
                                  Style="{StaticResource ThemedDataGrid}"
                                  BorderThickness="0"
                                  IsReadOnly="True"
                                  AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="*" />
                                <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="1.5*" />
                                <DataGridTextColumn Header="Invoice date"
                                                    Binding="{Binding InvoiceDate, StringFormat=yyyy-MM-dd}"
                                                    Width="Auto" />
                                <DataGridTextColumn Header="Lines" Binding="{Binding LineCount}" Width="Auto" />
                                <DataGridTextColumn Header="Value"
                                                    Binding="{Binding TotalValue, StringFormat=N2}"
                                                    Width="Auto" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="340"
                                   TextAlignment="Center"
                                   Text="No purchases yet, or nothing matches the current filters. Use New purchase to record a supplier invoice."
                                   Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding DetailHeading}" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding DetailStatusText}"
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,10" />

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding Detail.Lines}"
                                  Style="{StaticResource ThemedDataGrid}"
                                  BorderThickness="0"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineName}" Width="1.6*" />
                                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="Auto" />
                                <DataGridTextColumn Header="Expiry"
                                                    Binding="{Binding ExpiryDate, StringFormat=yyyy-MM-dd}"
                                                    Width="Auto" />
                                <DataGridTextColumn Header="Qty"
                                                    Binding="{Binding Quantity, StringFormat=N3}"
                                                    Width="Auto" />
                                <DataGridTextColumn Header="Cost"
                                                    Binding="{Binding UnitCost, StringFormat=N2}"
                                                    Width="Auto" />
                                <DataGridTextColumn Header="Price"
                                                    Binding="{Binding SellingPrice, StringFormat=N2}"
                                                    Width="Auto" />
                                <DataGridTextColumn Header="Line total"
                                                    Binding="{Binding LineTotal, StringFormat=N2}"
                                                    Width="Auto" />
                                <DataGridTextColumn Header="Batch id"
                                                    Binding="{Binding MedicineBatchId}"
                                                    Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Editor and actions -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Editor.Heading}" Style="{StaticResource SectionHeaderText}" />
                        <TextBlock Text="{Binding Editor.StatusText}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />

                        <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />

                        <Border Visibility="{Binding Editor.HasValidationMessage, Converter={StaticResource BoolToVisibility}}"
                                Background="{StaticResource DangerSoftBrush}"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,12">
                            <TextBlock Text="{Binding Editor.ValidationMessage}"
                                       Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="12" />
                        </Border>

                        <TextBlock Text="Supplier" Style="{StaticResource FieldLabelText}" />
                        <ComboBox Style="{StaticResource ThemedComboBox}"
                                  ItemsSource="{Binding Editor.Suppliers}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding Editor.SupplierId}" />

                        <TextBlock Text="Supplier invoice number" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource ThemedTextBox}"
                                     Text="{Binding Editor.InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="A repeated invoice number for the same supplier is warned about before saving or receiving" />
                            <Button Grid.Column="1"
                                    Content="Check number"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding CheckInvoiceNumberCommand}"
                                    IsEnabled="{Binding CanCheckDuplicate}" />
                        </Grid>

                        <TextBlock Text="Invoice date" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
                        <DatePicker SelectedDate="{Binding Editor.InvoiceDate, Converter={StaticResource DateOnlyToDateTime}}" />

                        <TextBlock Text="Notes" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource ThemedTextBox}"
                                 Text="{Binding Editor.Notes}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="46"
                                 VerticalScrollBarVisibility="Auto" />

                        <Border Style="{StaticResource Divider}" Margin="0,14,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Lines" Style="{StaticResource FieldLabelText}" />
                            <TextBlock Text="{Binding Editor.LineSummary}"
                                       Style="{StaticResource CaptionText}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Editor.Lines}"
                                  Style="{StaticResource ThemedDataGrid}"
                                  BorderThickness="0"
                                  MaxHeight="200"
                                  AlternationCount="2"
                                  IsEnabled="{Binding Editor.IsEditable}"
                                  Margin="0,6,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineName}" Width="1.4*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                                <DataGridTextColumn Header="Expiry"
                                                    Binding="{Binding ExpiryDate, Converter={StaticResource DateOnlyToDateTime}, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="Auto" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                                <DataGridTextColumn Header="Cost" Binding="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                                <DataGridTextColumn Header="Price" Binding="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                                <DataGridTextColumn Header="Total"
                                                    Binding="{Binding LineTotal, StringFormat=N2}"
                                                    Width="Auto"
                                                    IsReadOnly="True" />
                                <DataGridTemplateColumn Header="" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove"
                                                    Style="{StaticResource LinkButton}"
                                                    Command="{Binding DataContext.Editor.RemoveLineCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="{Binding Editor.LinesTotalText}"
                                   Style="{StaticResource MetricValueText}"
                                   HorizontalAlignment="Right"
                                   Margin="0,8,0,0" />

                        <Border Style="{StaticResource Divider}" Margin="0,12,0,10" />

                        <!-- Add a line -->
                        <TextBlock Text="Add a line" Style="{StaticResource FieldLabelText}" />
                        <ComboBox Style="{StaticResource ThemedComboBox}"
                                  ItemsSource="{Binding Editor.Medicines}"
                                  DisplayMemberPath="Summary"
                                  SelectedItem="{Binding Editor.NewLineMedicine}"
                                  IsTextSearchEnabled="True"
                                  Margin="0,4,0,0"
                                  ToolTip="Type to jump to a medicine" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" MinWidth="118" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Batch number" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource ThemedTextBox}"
                                         Text="{Binding Editor.NewLineBatchNumber, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Expiry" Style="{StaticResource FieldLabelText}" />
                                <DatePicker SelectedDate="{Binding Editor.NewLineExpiryDate, Converter={StaticResource DateOnlyToDateTime}}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Quantity" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource ThemedTextBox}"
                                         Text="{Binding Editor.NewLineQuantity, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Unit cost" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource ThemedTextBox}"
                                         Text="{Binding Editor.NewLineUnitCost, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Selling price" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource ThemedTextBox}"
                                         Text="{Binding Editor.NewLineSellingPrice, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Button Content="Add line"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding Editor.AddLineCommand}"
                                IsEnabled="{Binding Editor.IsEditable}" />

                        <Border Visibility="{Binding HasDuplicateWarning, Converter={StaticResource BoolToVisibility}}"
                                Background="{StaticResource WarningSoftBrush}"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Possible duplicate invoice"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Text="{Binding DuplicateWarning}"
                                           Foreground="{StaticResource WarningBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Divider}" Margin="0,14,0,12" />

                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsNotBusy}">
                            <Button Content="{Binding Editor.SaveButtonText}"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveCommand}" />
                            <Button Content="Reset"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding ResetEditorCommand}" />
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,16,0,12" />

                        <!-- Receiving -->
                        <TextBlock Text="Receiving" Style="{StaticResource FieldLabelText}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="130" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Received on" Style="{StaticResource FieldLabelText}" />
                                <DatePicker SelectedDate="{Binding ReceivedOn, Converter={StaticResource DateOnlyToDateTime}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Received by" Style="{StaticResource FieldLabelText}" />
                                <TextBox Style="{StaticResource ThemedTextBox}" Text="{Binding ReceivedBy}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Text="Receiving creates one batch and one receipt movement per line inside a single transaction. A purchase that is already received is refused, so the same invoice cannot be taken into stock twice." />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding IsNotBusy}">
                            <Button Content="Receive into stock"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ReceiveCommand}"
                                    IsEnabled="{Binding CanReceive}" />
                            <Button Content="Reverse receipt"
                                    Style="{StaticResource DangerButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding ReverseCommand}"
                                    IsEnabled="{Binding CanReverse}" />
                            <Button Content="Cancel draft"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding CancelPurchaseCommand}"
                                    IsEnabled="{Binding CanCancel}" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
