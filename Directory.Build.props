<Project>

  <PropertyGroup>
	<LangVersion>latest</LangVersion>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<NeutralLanguage>en</NeutralLanguage>

	<Product>MediStock</Product>
	<Company>MediStock</Company>

	<!-- The single source of truth for the version. MINOR tracks the milestone:
	     0.5.0 = Milestone 5. See plan.md section 8 and docs/release-process.md. -->
	<Version>0.5.0</Version>
	<AssemblyVersion>0.5.0.0</AssemblyVersion>
	<FileVersion>0.5.0.0</FileVersion>
	<Authors>MediStock</Authors>

	<!-- Deterministic, reproducible-ish builds; keep warnings visible but not fatal. -->
	<EnableNETAnalyzers>true</EnableNETAnalyzers>
	<AnalysisLevel>latest</AnalysisLevel>
	<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
